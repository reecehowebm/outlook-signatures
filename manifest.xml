<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
 xmlns:ov="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
 xsi:type="MailApp">
 <Id>9a6d0d4f-fe3c-49b9-9cc5-08e78389145a</Id>
 <Version>1.0.0.0</Version>
 <ProviderName>Bridmet</ProviderName>
 <DefaultLocale>en-GB</DefaultLocale>
 <DisplayName DefaultValue="Bridmet Signature"/>
 <Description DefaultValue="Insert your individual name with the standard Bridmet Purchasing Team signature."/>
 <IconUrl DefaultValue="https://YOUR-STATIC-WEB-APP.azurestaticapps.net/icon-64.png"/>
 <HighResolutionIconUrl DefaultValue="https://YOUR-STATIC-WEB-APP.azurestaticapps.net/icon-128.png"/>
 <SupportUrl DefaultValue="https://YOUR-STATIC-WEB-APP.azurestaticapps.net/"/>
 <AppDomains><AppDomain>https://YOUR-STATIC-WEB-APP.azurestaticapps.net</AppDomain></AppDomains>
 <Hosts><Host Name="Mailbox"/></Hosts>
 <Requirements><Sets DefaultMinVersion="1.10"><Set Name="Mailbox" MinVersion="1.10"/></Sets></Requirements>
 <FormSettings><Form xsi:type="ItemEdit"><DesktopSettings><SourceLocation DefaultValue="https://YOUR-STATIC-WEB-APP.azurestaticapps.net/index.html"/></DesktopSettings></Form></FormSettings>
 <Permissions>ReadWriteItem</Permissions>
 <Rule xsi:type="RuleCollection" Mode="Or"><Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/></Rule>
 <DisableEntityHighlighting>false</DisableEntityHighlighting>
 <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_1">
  <Requirements><bt:Sets DefaultMinVersion="1.10"><bt:Set Name="Mailbox" MinVersion="1.10"/></bt:Sets></Requirements>
  <Hosts><Host xsi:type="MailHost">
   <DesktopFormFactor>
    <FunctionFile resid="Commands.Url"/>
    <ExtensionPoint xsi:type="MessageComposeCommandSurface">
     <OfficeTab id="TabDefault"><Group id="BridmetSignatureGroup">
      <Label resid="Group.Label"/>
      <Control xsi:type="Button" id="OpenBridmetSignature">
       <Label resid="Button.Label"/>
       <Supertip><Title resid="Button.Label"/><Description resid="Button.Description"/></Supertip>
       <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
       <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url"/></Action>
      </Control>
     </Group></OfficeTab>
    </ExtensionPoint>
   </DesktopFormFactor>
  </Host></Hosts>
  <Resources>
   <bt:Images>
    <bt:Image id="Icon.16" DefaultValue="https://YOUR-STATIC-WEB-APP.azurestaticapps.net/icon-16.png"/>
    <bt:Image id="Icon.32" DefaultValue="https://YOUR-STATIC-WEB-APP.azurestaticapps.net/icon-32.png"/>
    <bt:Image id="Icon.80" DefaultValue="https://YOUR-STATIC-WEB-APP.azurestaticapps.net/icon-80.png"/>
   </bt:Images>
   <bt:Urls>
    <bt:Url id="Commands.Url" DefaultValue="https://YOUR-STATIC-WEB-APP.azurestaticapps.net/commands.html"/>
    <bt:Url id="Taskpane.Url" DefaultValue="https://YOUR-STATIC-WEB-APP.azurestaticapps.net/index.html"/>
   </bt:Urls>
   <bt:ShortStrings><bt:String id="Group.Label" DefaultValue="Bridmet"/><bt:String id="Button.Label" DefaultValue="Insert my signature"/></bt:ShortStrings>
   <bt:LongStrings><bt:String id="Button.Description" DefaultValue="Insert your name and the standard Bridmet Purchasing Team signature."/></bt:LongStrings>
  </Resources>
 </VersionOverrides>
</OfficeApp>
